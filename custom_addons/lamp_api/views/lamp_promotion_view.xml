<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="api_lamp_promotion_form" model="ir.ui.view">
        <field name="name">lamp.promotion.view.form</field>
        <field name="model">lamp.promotion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="product_id" domain="[('detailed_type', '=', 'product')]"/>
                        </group>
                    </group>
                    <group>
                        <field name="image" widget="image"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="api_lamp_promotion_tree" model="ir.ui.view">
        <field name="name">lamp.promotion.view.tree</field>
        <field name="model">lamp.promotion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <record id="api_lamp_promotion_action" model="ir.actions.act_window">
        <field name="name">近期活动</field>
        <field name="res_model">lamp.promotion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="lamp_promotion_config"
              name="近期活动"
              parent="lamp_menu_root"
              sequence="1"
              action="api_lamp_promotion_action"/>
</odoo>
