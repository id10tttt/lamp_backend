<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="warehouse_id"/>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="pickup_code"/>
                </xpath>
                <xpath
                        expr="//field[@name='order_line']/form//field[@name='customer_lead']"
                        position="after"
                >
                    <button name="rental_product_available_qty" string="库存查询" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//notebook" position="before">
                    <group>
                        <group>
                            <field name="coupon"/>
                            <field name="reserve"/>
                            <field name="order_amount"/>
                        </group>
                        <group>
                            <field name="pay_state"/>
                            <field name="return_time"/>
                            <field name="actual_return_time"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="deposit"/>
                            <field name="dock"/>
                            <field name="labor_cost"/>
                            <field name="stock_preparation"/>
                        </group>
                        <group>
                            <field name="active_address"/>
                            <field name="billing_days"/>
                            <field name="balance_amount"/>
                            <field name="changed"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="defer"/>
                            <field name="picker_partner_id"/>
                            <field name="picker"/>
                            <field name="picker_phone"/>
                            <field name="pick_time"/>
                            <field name="actual_pick_time"/>
                        </group>
                        <group>
                            <field name="full_reduction"/>
                            <field name="arrival_time"/>
                            <field name="stock_status"/>
                            <field name="payment_status"/>
                            <field name="payment_time"/>
                            <field name="status"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//notebook/page[@name='other_information']" position="inside">
                    <group>
                        <field name="picker_id_card"/>
                        <field name="picker_selfie"/>
                    </group>
                </xpath>
                <xpath expr="//notebook/page[@name='other_information']" position="before">
                    <page string="优惠券">
                        <group>
                            <field name="promo_code"/>
                            <field name="redeem_amount"/>
                            <field name="reward_amount"/>
                            <field name="code_promo_program_id"/>
                            <field name="applied_coupon_ids"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
