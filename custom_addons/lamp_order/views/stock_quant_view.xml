<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_stock_quant_tree_inventory_editable_inherit" model="ir.ui.view">
            <field name="name">stock.quant tree inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='quantity']" position="attributes">
                    <attribute name="sum">库存统计</attribute>
                </xpath>
                <xpath expr="//tree/field[@name='available_quantity']" position="before">
                    <field name="reserved_quantity" string="预留的数量"/>
                </xpath>
                <xpath expr="//tree/field[@name='inventory_date']" position="replace">
                    <field name="in_date" string="入库日期" widget="date"/>
                    <field name="value" sum="1"/>
                </xpath>
            </field>
        </record>
        <record id="quant_search_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant search inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.quant_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="." position="inside">
                    <searchpanel>
                        <field name="warehouse_id" icon="fa-filter"/>
                    </searchpanel>
                    <filter string="仓库" name="warehouse_group" context="{'group_by': 'warehouse_id'}"/>
                </xpath>
            </field>
        </record>
        <record id="view_stock_quant_tree_editable_inherit" model="ir.ui.view">
            <field name="name">stock.quant tree inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='available_quantity']" position="before">
                    <field name="reserved_quantity" string="预留的数量"/>
                </xpath>
                <xpath expr="//tree" position="attributes">
                    <attribute name="editable">bottom</attribute>
                    <attribute name="create">1</attribute>
                    <attribute name="edit">1</attribute>
                    <attribute name="import">1</attribute>
                </xpath>
                <xpath expr="//tree" position="inside">
                    <button name="action_inventory_history" type="object" class="btn btn-link text-info"
                            icon="fa-history" string="历史"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_stock_quant_report">
            <field name="name">stock.quant report</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <tree default_order="location_id, inventory_date, product_id, package_id, lot_id, owner_id"
                      decoration-warning='is_outdated' create="0" edit="0" import="0"
                      js_class="singleton_list">
                    <field name="id" invisible="1"/>
                    <field name="is_outdated" invisible="1"/>
                    <field name="tracking" invisible="1"/>
                    <field name="inventory_quantity_set" invisible="1"/>
                    <field name="location_id" domain="[('usage', 'in', ['internal', 'transit'])]"
                           attrs="{'readonly': [('id', '!=', False)]}" invisible="context.get('hide_location', False)"
                           options="{'no_create': True}" optional="show"/>
                    <field name="warehouse_id" optional="show"/>
                    <field name="product_id" attrs="{'readonly': [('id', '!=', False)]}"
                           readonly="context.get('single_product', False)" force_save="1"
                           optional="show"
                           options="{'no_create': True}"/>
                    <field name="product_categ_id" optional="hide"/>
                    <field name="lot_id" groups="stock.group_production_lot"
                           attrs="{'readonly': ['|', ('id', '!=', False), ('tracking', 'not in', ['serial', 'lot'])]}"
                           invisible="context.get('hide_lot', False)"
                           context="{'default_product_id': product_id, 'default_company_id': company_id}"/>
                    <field name="package_id" groups="stock.group_tracking_lot"
                           attrs="{'readonly': [('id', '!=', False)]}"/>
                    <field name="owner_id" groups="stock.group_tracking_owner"
                           attrs="{'readonly': [('id', '!=', False)]}" options="{'no_create': True}"/>
                    <field name="reserved_quantity" string="预留的数量"/>
                    <field name="quantity" optional="show" string="在手数" sum="库存统计"/>
                    <field name="available_quantity" string="可用数"
                           decoration-danger="available_quantity &lt; 0" optional="hidden"/>
                    <field name="product_uom_id" groups="uom.group_uom" string="单位"/>
                    <field name="inventory_quantity" widget="counted_quantity_widget"/>
                    <field name="inventory_diff_quantity" string="差异"
                           attrs="{'invisible': [('inventory_quantity_set', '=', False)]}"
                           decoration-muted="inventory_diff_quantity == 0"
                           decoration-danger="inventory_diff_quantity &lt; 0"
                           decoration-success="inventory_diff_quantity &gt; 0"
                           decoration-bf="inventory_diff_quantity != 0"/>
                    <field name="inventory_date" optional="hide"/>
                    <field name="in_date" string="入库日期" widget="date" optional="show"/>
                    <field name="value" sum="1" optional="show"/>
                    <field name="user_id" string="用户" optional="hide"/>
                    <field name='company_id' string='公司' groups="base.group_multi_company" optional="hide"/>
                    <button name="action_inventory_history" type="object" class="btn btn-link text-info"
                            icon="fa-history" string="历史"/>
                </tree>
            </field>
        </record>
        <record id="action_view_stock_quants_report" model="ir.actions.act_window">
            <field name="name">今日盘点</field>
            <field name="res_model">stock.quant</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_stock_quant_report"/>
            <field name="domain">[('location_id.usage', '=', 'internal')]</field>
            <field name="context">{
                }
            </field>
        </record>
        <menuitem id="stock.menu_valuation" name="今日盘点"
                  parent="stock.menu_warehouse_report" sequence="100"
                  action="action_view_stock_quants_report"/>
    </data>
</odoo>
