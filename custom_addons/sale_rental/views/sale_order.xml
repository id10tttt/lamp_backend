<odoo>

    <record id="view_quotation_tree_with_onboarding_inherit" model="ir.ui.view">
            <field name="name">sale.order inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="date_order"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="total_rental_qty" sum="1"/>
                </xpath>
            </field>
        </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale_rental.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_start_end_dates.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='start_date']" position="before">
                <field name="rental_type"
                       invisible="rental == False"
                       required="rental == True"/>
                <field name="extension_rental_id"
                       options="{'no_quick_create': True, 'no_create_edit': True}"
                       invisible="rental_type != 'rental_extension'"
                       required="rental_type == 'rental_extension'"
                       domain="[('rental_product_id', '=', product_id), ('state', 'in', ('ordered', 'out')), ('company_id', '=', company_id)]"/>
                <field name="sell_rental_id"
                       options="{'no_quick_create': True, 'no_create_edit': True}"
                       invisible="can_sell_rental == False"
                       domain="[('rented_product_id', '=', product_id), ('state', '=', 'out'), ('company_id', '=', company_id)]"/>
                <field name="rental"/>
                <field name="can_sell_rental" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="rental_qty"
                       invisible="rental == False"
                       required="rental == True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="editable"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="rental_qty"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">-->
            <!--                <attribute name="invisible">1</attribute>-->
            <!--            </xpath>-->
        </field>
    </record>


</odoo>
